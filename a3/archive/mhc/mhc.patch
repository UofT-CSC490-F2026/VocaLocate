+def sinkhorn_log(log_m, iters=20):
+    """Sinkhorn-Knopp in log space: rows and columns of the returned exp(log_m) each sum to 1 (to fp32 precision)."""
+    for _ in range(iters):
+        log_m = log_m - torch.logsumexp(log_m, dim=-1, keepdim=True)
+        log_m = log_m - torch.logsumexp(log_m, dim=-2, keepdim=True)
+    return log_m.exp()
+
+
+class ManifoldHyperConnection(nn.Module):
+    """One layer's per-token mHC coefficients, computed from the RMS-normed streams plus learned static biases."""
+    def __init__(self, n_embd, n_streams, layer_idx):
+        super().__init__()
+        self.n, self.stream = n_streams, layer_idx % n_streams
+        # Packed into one matrix and one vector: the compiled AdamW step recompiles per parameter shape, with a limit of 8.
+        self.w = Linear(n_streams * n_embd, 2 * n_streams + n_streams ** 2, bias=False) # pre | post | res
+        self.b = nn.Parameter(torch.empty(3 + 2 * n_streams + n_streams ** 2)) # gates | pre | post | res
+
+    def _split(self, v):
+        n = self.n
+        return v[..., :n], v[..., n:2 * n], v[..., 2 * n:]
+
+    @torch.no_grad()
+    def reset_parameters(self):
+        torch.nn.init.normal_(self.w.weight, std=0.02)
+        self.b[:3].fill_(0.01) # gates
+        b_pre, b_post, b_res = self._split(self.b[3:])
+        # Read mostly this layer's stream (weights sum to 1, and starting streams are equal, so the first read is x0).
+        # A different stream per layer is what breaks the symmetry between otherwise identical streams.
+        favoured, other = 0.7, 0.3 / max(self.n - 1, 1)
+        b_pre.fill_(math.log(other / (1 - other)))
+        b_pre[self.stream] = math.log(favoured / (1 - favoured))
+        b_post.zero_() # 2 * sigmoid(0) = 1: write the output to every stream, like a plain residual
+        b_res.fill_(-4.0)
+        b_res[::self.n + 1] = 0.0 # near-identity mixing (the diagonal of the flattened n x n matrix)
+
+    def forward(self, streams):
+        B, T, n, _ = streams.size()
+        flat = norm(streams).flatten(-2)
+        b = self.b.to(streams.dtype)
+        gates = b[:3]
+        b_pre, b_post, b_res = self._split(b[3:])
+        w_pre, w_post, w_res = self._split(torch.tanh(self.w(flat)))
+        h_pre = torch.sigmoid(b_pre + gates[0] * w_pre)
+        h_post = 2 * torch.sigmoid(b_post + gates[1] * w_post)
+        log_res = (b_res + gates[2] * w_res).view(B, T, n, n)
+        h_res = sinkhorn_log(log_res.float()).to(streams.dtype) # fp32: bf16 rounding would break the sums to 1
+        return h_pre, h_post, h_res
+
