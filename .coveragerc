[run]
# Measure branches as well as lines: an `if` whose False side never runs is untested logic,
# even when every line in it executes.
branch = True
source =
    vocalocate_pipeline
    vocalocate_demo
    ${VOCALOCATE_REPO_ROOT-.}/demo/modal
omit =
    */vocalocate_demo/efficientat/*

[report]
precision = 2
show_missing = True
